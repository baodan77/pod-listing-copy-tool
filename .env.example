# Required (pick one key source: plain OPENAI_API_KEY, or HEX / HEX_01…)
OPENAI_API_KEY=your_openai_or_compatible_proxy_key
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Optional
PORT=3000
NODE_ENV=development
DATA_DIR=./data
OPENAI_MODEL=gemini-4-argon-medium
# OpenAI-compatible proxy (NewAPI / OneAPI / etc.). Default is https://api.openai.com/v1
OPENAI_BASE_URL=https://api.xgapiproxy.win/v1
# Hex encoding of OPENAI_API_KEY. Optional; useful when dashboards/MCP truncate sk- keys.
# Prefer hex over the plain key when any of these is set. Numbered parts are
# concatenated in order from _01; the first missing number ends the sequence.
# OPENAI_API_KEY_HEX=
# OPENAI_API_KEY_HEX_01=
# OPENAI_API_KEY_HEX_02=
